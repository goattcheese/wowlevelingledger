rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two signed-in accounts may read or write. Replace both emails.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['goattcheese@gmail.com', 'emenem3@hotmail.com', 'blair_duncan@live.ca','ledger-bot@shane.soehner.com','ledger];
    }
  }
}
